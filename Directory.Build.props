<Project>

  <!--
    ============================================================================
    Native FFmpegKit version pins
    ============================================================================
    Android and iOS get their native binaries from different upstreams with different version
    schemes, and neither tracks FFmpeg's own numbering directly - see the README and
    src/FFmpegKit.Net.Android/Jars/FetchJars.sh / build/FetchXcFrameworks.sh for where each
    number is used.
  -->
  <PropertyGroup>
    <!--
      The FFmpeg build every package advertises. Package versions are based on this, not on
      either native repository's own release numbers, because this is what determines behaviour.
    -->
    <FFmpegVersion>8.1.2</FFmpegVersion>

    <!--
      iOS binaries come from sk3llo/ffmpeg_kit_flutter (the only source still publishing all
      eight xcframework variants for Apple platforms), which tags its releases with the FFmpeg
      version directly - see build/FetchXcFrameworks.sh.
    -->
    <FFmpegKitIosNativeVersion>8.1.2</FFmpegKitIosNativeVersion>

    <!--
      Android binaries come from ffmpegkit-maintained/ffmpeg on Maven Central, whose own release
      numbering does not track FFmpeg's - FFmpegKit 8.1.7 packages FFmpeg n8.1.2. This is the
      FFmpegKit release, used to name the .aar to download; see
      src/FFmpegKit.Net.Android/Jars/FetchJars.sh and build/native-versions.tsv.
    -->
    <FFmpegKitAndroidNativeVersion>8.1.7</FFmpegKitAndroidNativeVersion>

    <!--
      Belongs to this repository, not to either native build. Increments whenever the bindings,
      the cross-platform layer or the packaging change while FFmpegVersion stays put.
    -->
    <FFmpegKitBindingRevision>1</FFmpegKitBindingRevision>
    <VersionPrefix>$(FFmpegVersion).$(FFmpegKitBindingRevision)</VersionPrefix>

    <!--
      Which FFmpegKit variant to build: Audio, Full, FullGpl, Https, HttpsGpl, Min, MinGpl, Video.
      CI builds each of these in turn for every variant-parameterized project (the two bindings,
      the cross-platform client and the MAUI package).
    -->
    <FFmpegKitBuildType Condition=" '$(FFmpegKitBuildType)' == '' ">Video</FFmpegKitBuildType>

    <Authors>s.bokatuk</Authors>
    <Company>s.bokatuk</Company>
    <Copyright>Copyright © s.bokatuk</Copyright>
    <PackageProjectUrl>https://github.com/sbokatuk/FFmpegKit.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sbokatuk/FFmpegKit.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      No PackageLicenseExpression here: it is not one value for the whole repository. The C#
      source is MIT throughout, but the two binding packages also ship native FFmpeg binaries
      that are LGPL-3.0 or GPL-3.0 depending on the variant, so the expression is built per
      variant in FFmpegKit.Net.Android.csproj / FFmpegKit.Net.iOS.csproj. The cross-platform and
      MAUI packages carry no native payload of their own, but declare the same expression as the
      binding they pull in, since that is what a consumer actually ends up with transitively.
    -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition=" '$(GITHUB_ACTIONS)' == 'true' ">true</ContinuousIntegrationBuild>

    <!--
      net8.0-* and net9.0-* are past end of support, which the SDK reports as an error. They ship
      deliberately: .NET 8 is still where a large share of MAUI apps are.
    -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>

  <!--
    ============================================================================
    Target frameworks
    ============================================================================
    No single .NET SDK can build net8, net9 and net10 for a given platform - each SDK's workload
    carries the current target framework and the previous one only. Verified support matrix:

                  SDK 9 band                              SDK 10 band
      Android     net8.0-android34.0, net9.0-android35.0  net10.0-android36.0
      iOS         net8.0-ios18.0,     net9.0-ios18.0       net10.0-ios26.0

    So every variant-parameterized project is packed twice and the results merged - see
    build/BuildNugets.sh and build/merge-packages.py. FFmpegKitSdkBand selects which pass a given
    build is.

    The platform version in each target framework is pinned deliberately. Bare 'net8.0-android'
    resolves to android21.0, which produces a binding assembly with no .aar payload - it compiles,
    packs and installs, and fails only at runtime. The same applies to 'net8.0-ios', where an
    unpinned default also changes the lib/<tfm>/ folder name a workload update would silently move.
  -->
  <PropertyGroup>
    <FFmpegKitSdkBand Condition=" '$(FFmpegKitSdkBand)' == '' ">net9</FFmpegKitSdkBand>

    <FFmpegKitAndroidTargetFrameworks Condition=" '$(FFmpegKitSdkBand)' == 'net9' ">net8.0-android34.0;net9.0-android35.0</FFmpegKitAndroidTargetFrameworks>
    <FFmpegKitAndroidTargetFrameworks Condition=" '$(FFmpegKitSdkBand)' == 'net10' ">net10.0-android36.0</FFmpegKitAndroidTargetFrameworks>

    <FFmpegKitIosTargetFrameworks Condition=" '$(FFmpegKitSdkBand)' == 'net9' ">net8.0-ios18.0;net9.0-ios18.0</FFmpegKitIosTargetFrameworks>
    <FFmpegKitIosTargetFrameworks Condition=" '$(FFmpegKitSdkBand)' == 'net10' ">net10.0-ios26.0</FFmpegKitIosTargetFrameworks>
  </PropertyGroup>

  <!--
    ============================================================================
    Per-variant obj/ and bin/
    ============================================================================
    All eight variants of every variant-parameterized project are built one after another in the
    same working copy, and they differ only in which native payload gets linked in - a shared
    intermediate output would let one variant's binaries end up in the next one's package.
    Applies to every project whose output depends on FFmpegKitBuildType.
  -->
  <PropertyGroup Condition="
      '$(MSBuildProjectName)' == 'FFmpegKit.Net.Android' Or
      '$(MSBuildProjectName)' == 'FFmpegKit.Net.iOS' Or
      '$(MSBuildProjectName)' == 'FFmpegKit.Net' Or
      '$(MSBuildProjectName)' == 'FFmpegKit.Net.Maui'">
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj/$(FFmpegKitBuildType)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/$(FFmpegKitBuildType)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
